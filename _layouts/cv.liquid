---
layout: default
---
<div class="post cv-document">
  <header class="post-header">
    <p class="eyebrow">Experience &amp; qualifications</p>
    <h1 class="post-title">{{ page.title | escape }}</h1>
    {% if page.description %}
      <p class="post-description">{{ page.description | escape }}</p>
    {% endif %}
    {% if page.cv_pdf %}
      {% if page.cv_pdf contains '://' %}
        {% assign cv_pdf_url = page.cv_pdf %}
      {% else %}
        {% assign cv_pdf_url = page.cv_pdf | prepend: 'assets/pdf/' | relative_url %}
      {% endif %}
      <p class="cv-actions"><a class="button button-primary" href="{{ cv_pdf_url }}" target="_blank" rel="noopener noreferrer">Download résumé (PDF)</a></p>
    {% endif %}
  </header>

  <nav class="cv-navigation" aria-label="CV sections"><a href="#Professional%20Experience">Experience</a><a href="#Core%20Competencies">Expertise</a><a href="#Technologies%20%26%20Tools">Tools</a><a href="#Key%20Projects">Projects</a><a href="#Education">Education</a><a href="#Certifications%20%26%20Badges">Credentials</a></nav>
  <article>
    {% for entry in site.data.cv %}
      <section class="cv-section" id="{{ entry.title | escape }}" aria-labelledby="cv-{{ entry.title | slugify }}">
        {% if entry.title == 'Key Projects' %}<span id="Open Source Projects" aria-hidden="true"></span>{% endif %}
        <h2 id="cv-{{ entry.title | slugify }}">{{ entry.title | escape }}</h2>
        {% case entry.type %}
          {% when 'map' %}
            <dl class="cv-facts">
              {% for content in entry.contents %}
                <dt>{{ content.name | escape }}</dt>
                <dd>
                  {% if content.value %}{{ content.value | markdownify }}{% endif %}
                  {% for item in content.links %}
                    {% if item.link %}<a href="{{ item.link }}" target="_blank" rel="noopener noreferrer">{{ item.name | default: 'View document' | escape }}</a>{% endif %}
                  {% endfor %}
                </dd>
              {% endfor %}
            </dl>
          {% when 'list' %}
            <div class="cv-prose">
              {% for content in entry.contents %}{{ content | markdownify }}{% endfor %}
            </div>
          {% when 'nested_list' %}
            <div class="skills-grid">
              {% for content in entry.contents %}
                <div class="skill-group">
                  <h3>{{ content.title | escape }}</h3>
                  <ul class="skill-list">
                    {% for item in content.items %}<li>{{ item | escape }}</li>{% endfor %}
                  </ul>
                </div>
              {% endfor %}
            </div>
          {% when 'skills' %}
            {% include skills.liquid %}
          {% when 'time_table' %}
            {% include cv/time_table.liquid %}
          {% when 'list_groups' %}
            {% include cv/list_groups.liquid %}
          {% when 'badges' %}
            {% include cv/badges.liquid %}
          {% else %}
            {{ entry.contents }}
        {% endcase %}
      </section>
    {% endfor %}
  </article>
</div>
