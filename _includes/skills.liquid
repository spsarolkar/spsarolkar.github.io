<div class="skills-section mt-4 mb-5">
  <div class="row">
    {% for category in site.data.skills %}
    <div class="col-md-6 mb-4" data-animate data-animate-delay="{{ forloop.index }}">
      <div class="skill-category h-100">
        <h4 class="skill-category-title mb-3" style="color: {{ category.color }}">
          <i class="{{ category.icon }} mr-2"></i> {{ category.name }}
        </h4>
        <div class="skill-badges">
          {% for skill in category.items %}
          <div class="skill-badge" data-toggle="tooltip" title="{{ skill.level }}% Proficiency">
            <i class="{{ skill.icon }}"></i>
            <span>{{ skill.name }}</span>
            <div class="skill-level-bar" style="width: {{ skill.level }}%; background-color: {{ category.color }}"></div>
          </div>
          {% endfor %}
        </div>
      </div>
    </div>
    {% endfor %}
  </div>
</div>


