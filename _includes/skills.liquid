<div class="skills-grid">
  {% for category in site.data.skills %}
    <div class="skill-group">
      <h3>{{ category.name | escape }}</h3>
      <ul class="skill-list">
        {% for skill in category.items %}<li>{{ skill.name | escape }}</li>{% endfor %}
      </ul>
    </div>
  {% endfor %}
</div>
