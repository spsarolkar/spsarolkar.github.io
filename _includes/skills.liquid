<div class="skills-section mt-4 mb-5">
  <div class="row">
    {% for category in site.data.skills %}
    <div class="col-md-6 mb-4" data-animate data-animate-delay="{{ forloop.index }}">
      <div class="skill-category h-100">
        <h4 class="skill-category-title mb-3" style="color: {{ category.color }}">
          <i class="{{ category.icon }} mr-2"></i> {{ category.name }}
        </h4>
        <div class="skill-badges">
          {% for skill in category.items %}
          <div class="skill-badge" data-toggle="tooltip" title="{{ skill.level }}% Proficiency">
            <i class="{{ skill.icon }}"></i>
            <span>{{ skill.name }}</span>
            <div class="skill-level-bar" style="width: {{ skill.level }}%; background-color: {{ category.color }}"></div>
          </div>
          {% endfor %}
        </div>
      </div>
    </div>
    {% endfor %}
  </div>
</div>

<style>
/* Scoped styles for skills section to ensure modularity */

/* Container */
.skill-category {
  padding: 1.5rem;
  border-radius: 16px;
  background: var(--global-card-bg-color);
  border: 1px solid var(--global-divider-color);
  transition: transform 0.3s ease, box-shadow 0.3s ease;
}

.skill-category:hover {
  transform: translateY(-5px);
  box-shadow: 0 10px 20px -5px rgba(0,0,0,0.1);
}

.skill-category-title {
  font-size: 1.1rem;
  font-weight: 700;
  border-bottom: 2px solid var(--global-divider-color);
  padding-bottom: 0.5rem;
  opacity: 0.9;
}

/* Badges Container */
.skill-badges {
  display: flex;
  flex-wrap: wrap;
  gap: 0.8rem;
}

/* Individual Badge */
.skill-badge {
  display: inline-flex;
  align-items: center;
  padding: 0.5rem 1rem;
  border-radius: 50px;
  background: var(--global-bg-color);
  border: 1px solid var(--global-divider-color);
  font-size: 0.9rem;
  font-weight: 500;
  color: var(--global-text-color);
  position: relative;
  overflow: hidden;
  transition: all 0.2s ease;
  cursor: default;
}

.skill-badge i {
  margin-right: 0.5rem;
  font-size: 1.1em;
}

/* Hover Effect */
.skill-badge:hover {
  transform: translateY(-2px);
  border-color: currentColor;
  box-shadow: 0 4px 6px -1px rgba(0,0,0,0.1);
}

/* Proficiency Bar (Subtle bottom line) */
.skill-level-bar {
  position: absolute;
  bottom: 0;
  left: 0;
  height: 3px;
  opacity: 0.7;
}

/* DARK MODE ADJUSTMENTS */
html[data-theme="dark"] .skill-category {
  background: rgba(255, 255, 255, 0.03); /* Glassy feel */
  border-color: rgba(255, 255, 255, 0.1);
}

html[data-theme="dark"] .skill-badge {
  background: rgba(0, 0, 0, 0.2);
  border-color: rgba(255, 255, 255, 0.1);
}

html[data-theme="dark"] .skill-badge:hover {
  background: rgba(255, 255, 255, 0.05);
  box-shadow: 0 0 15px rgba(6, 182, 212, 0.15); /* Tech glow */
}

/* DevIcons Integration Check */
@import url('https://cdn.jsdelivr.net/gh/devicons/devicon@latest/devicon.min.css');

</style>
