<div class="col" data-animate>
  <a href="{% if project.redirect %}{{ project.redirect }}{% else %}{{ project.url | relative_url }}{% endif %}">
    <div class="card project-card h-100">
      {% if project.img %}
        <div class="project-image-container">
          {%
            include figure.liquid
            loading="eager"
            path=project.img
            sizes = "350px"
            alt="project thumbnail"
            class="card-img-top project-image"
          %}
          {% if project.tech_stack %}
          <div class="project-tech-overlay">
            <div class="project-tech-stack">
              {% for tech in project.tech_stack %}
                <span class="project-tech-badge">{{ tech }}</span>
              {% endfor %}
            </div>
          </div>
          {% endif %}
        </div>
      {% endif %}
      <div class="card-body">
        <h2 class="card-title project-title">{{ project.title }}</h2>
        <p class="card-text project-description">{{ project.description }}</p>
        {% if project.tech_stack %}
        <div class="project-tech-badges-inline">
          {% for tech in project.tech_stack limit:3 %}
            <span class="project-tech-badge-small">{{ tech }}</span>
          {% endfor %}
          {% if project.tech_stack.size > 3 %}
            <span class="project-tech-badge-small">+{{ project.tech_stack.size | minus: 3 }}</span>
          {% endif %}
        </div>
        {% endif %}
        <div class="row ml-1 mr-1 p-0 mt-3">
          {% if project.github %}
            <div class="github-icon">
              <div class="icon" data-toggle="tooltip" title="Code Repository">
                <a href="{{ project.github }}"><i class="fa-brands fa-github gh-icon"></i></a>
              </div>
              {% if project.github_stars %}
                <span class="stars" data-toggle="tooltip" title="GitHub Stars">
                  <i class="fa-solid fa-star"></i>
                  <span id="{{ project.github_stars }}-stars"></span>
                </span>
              {% endif %}
            </div>
          {% endif %}
        </div>
      </div>
    </div>
  </a>
</div>
