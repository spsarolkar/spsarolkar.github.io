<article class="project-tile">
  {% if project.img %}
    <div class="project-image">
      {% include figure.liquid path=project.img sizes="(min-width: 800px) 50vw, 100vw" alt=project.title %}
    </div>
  {% endif %}
  <div class="project-body">
    {% if project.category %}
      <p class="project-category">
        {% case project.category %}
          {% when 'work' %}Applied work
          {% when 'fun' %}Independent project
          {% else %}{{ project.category | escape }}
        {% endcase %}
      </p>
    {% endif %}
    <h3 class="project-title"><a href="{{ project.url | relative_url }}">{{ project.title | escape }}</a></h3>
    {% if project.description %}
      <p class="project-description">{{ project.description | escape }}</p>
    {% endif %}
    {% if project.tech_stack and project.tech_stack.size > 0 %}
      <ul class="project-tags" aria-label="Technologies">
        {% for tech in project.tech_stack %}
          <li>{{ tech | escape }}</li>
        {% endfor %}
      </ul>
    {% endif %}
    {% if project.github or project.redirect %}
      <div class="project-links">
        {% if project.github %}
          <a href="{{ project.github }}" target="_blank" rel="noopener noreferrer">Source on GitHub</a>
        {% endif %}
        {% if project.redirect %}
          {% if project.redirect contains '://' %}
            <a href="{{ project.redirect }}" target="_blank" rel="noopener noreferrer">Visit project</a>
          {% else %}
            <a href="{{ project.redirect | relative_url }}">Visit project</a>
          {% endif %}
        {% endif %}
      </div>
    {% endif %}
  </div>
</article>
