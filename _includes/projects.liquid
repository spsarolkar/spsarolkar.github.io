<div class="col" data-animate>
  <a href="{% if project.redirect %}{{ project.redirect }}{% else %}{{ project.url | relative_url }}{% endif %}">
    <div class="card project-card h-100 hoverable">
      {% if project.img %}
        {%
          include figure.liquid
          loading="eager"
          path=project.img
          sizes = "250px"
          alt="project thumbnail"
          class="card-img-top"
        %}
      {% endif %}
      <div class="card-body">
        <h2 class="card-title">{{ project.title }}</h2>
        <p class="card-text">{{ project.description }}</p>
        {% if project.tech_stack %}
        <div class="project-tech-badges-inline mt-2">
          {% for tech in project.tech_stack limit:4 %}
            <span class="project-tech-badge-small">{{ tech }}</span>
          {% endfor %}
          {% if project.tech_stack.size > 4 %}
            <span class="project-tech-badge-small">+{{ project.tech_stack.size | minus: 4 }}</span>
          {% endif %}
        </div>
        {% endif %}
        <div class="row ml-1 mr-1 p-0 mt-3">
          {% if project.github %}
            <div class="github-icon">
              <div class="icon" data-toggle="tooltip" title="Code Repository">
                <a href="{{ project.github }}"><i class="fa-brands fa-github gh-icon"></i></a>
              </div>
              {% if project.github_stars %}
                <span class="stars" data-toggle="tooltip" title="GitHub Stars">
                  <i class="fa-solid fa-star"></i>
                  <span id="{{ project.github_stars }}-stars"></span>
                </span>
              {% endif %}
            </div>
          {% endif %}
        </div>
      </div>
    </div>
  </a>
</div>
