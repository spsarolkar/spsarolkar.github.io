<header class="site-header">
  <nav id="navbar" class="navbar navbar-light navbar-expand-md" aria-label="Main navigation">
    <div class="container">
      <a class="navbar-brand site-brand" href="{{ '/' | relative_url }}"><span class="brand-mark" aria-hidden="true">S.</span><span>Sunil Sarolkar</span></a>
      <button class="navbar-toggler collapsed" type="button" data-toggle="collapse" data-target="#navbarNav" aria-controls="navbarNav" aria-expanded="false" aria-label="Toggle navigation"><span>Menu</span><span class="menu-lines" aria-hidden="true">☰</span></button>
      <div class="collapse navbar-collapse" id="navbarNav">
        <ul class="navbar-nav ml-auto">
          <li class="nav-item{% if page.permalink == '/' %} active{% endif %}"><a class="nav-link" href="{{ '/' | relative_url }}"{% if page.permalink == '/' %} aria-current="page"{% endif %}>Profile</a></li>
          <li class="nav-item{% if page.url contains '/projects/' %} active{% endif %}"><a class="nav-link" href="{{ '/projects/' | relative_url }}"{% if page.url contains '/projects/' %} aria-current="page"{% endif %}>Projects</a></li>
          <li class="nav-item{% if page.url contains '/blog/' %} active{% endif %}"><a class="nav-link" href="{{ '/blog/' | relative_url }}"{% if page.url contains '/blog/' %} aria-current="page"{% endif %}>Writing</a></li>
          <li class="nav-item{% if page.permalink == '/cv/' %} active{% endif %}"><a class="nav-link" href="{{ '/cv/' | relative_url }}"{% if page.permalink == '/cv/' %} aria-current="page"{% endif %}>CV</a></li>
          <li class="nav-item nav-lab"><a class="nav-link" href="https://sunilsarolkar.in/">Personal lab <span aria-hidden="true">↗</span></a></li>
          {% if site.search_enabled %}<li class="nav-item"><button id="search-toggle" type="button" class="nav-tool" aria-label="Search this site" title="Search (Ctrl or Command K)" onclick="openSearchModal()"><i class="ti ti-search" aria-hidden="true"></i><span class="sr-only">Search</span></button></li>{% endif %}
          {% if site.enable_darkmode %}<li class="nav-item toggle-container"><button id="light-toggle" type="button" class="nav-tool" aria-label="Change colour theme" title="Change colour theme"><i class="ti ti-sun-moon" id="light-toggle-system" aria-hidden="true"></i><i class="ti ti-moon-filled" id="light-toggle-dark" aria-hidden="true"></i><i class="ti ti-sun-filled" id="light-toggle-light" aria-hidden="true"></i></button></li>{% endif %}
        </ul>
      </div>
    </div>
  </nav>
</header>
