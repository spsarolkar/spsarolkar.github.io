<div class="row">
  {% for badge in site.data.internal_badges %}
    <div class="col-6 col-md-3 mb-3 text-center">
       <div class="card h-100 border-0 shadow-sm" style="background-color: transparent;">
         <div class="card-body p-2 d-flex flex-column align-items-center">
           <img src="{{ badge.image | relative_url }}" alt="{{ badge.name }}" class="img-fluid mb-2" style="max-height: 80px; object-fit: contain;">
           <p class="mb-0 small font-weight-bold" style="font-size: 0.8rem; line-height: 1.2;">{{ badge.name }}</p>
         </div>
       </div>
    </div>
  {% endfor %}
</div>
