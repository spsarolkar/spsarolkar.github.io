{% for content in entry.contents %}
  {% assign education_credential = nil %}
  {% if entry.title == 'Education' %}
    {% assign education_credential = site.data.certifications | where: 'title', content.title | first %}
  {% endif %}
  <div class="cv-entry">
    <div class="cv-date">
      {% if education_credential %}
        <a href="{{ education_credential.url }}" target="_blank" rel="noopener noreferrer"><img class="cv-education-art" src="{{ education_credential.image | relative_url }}" alt="{{ education_credential.title | escape }} credential" loading="lazy"></a>
      {% elsif content.logo %}
        <img class="cv-education-art" src="{{ content.logo | relative_url }}" alt="{{ content.institution | escape }}" loading="lazy">
      {% endif %}
      {% if content.year %}<p>{{ content.year | escape }}</p>{% endif %}
      {% if content.location %}<p>{{ content.location | escape }}</p>{% endif %}
    </div>
    <div class="cv-body">
      {% if content.title %}
        <h3 class="cv-entry-title">
          {% if education_credential %}<a href="{{ education_credential.url }}" target="_blank" rel="noopener noreferrer">{{ content.title | escape }}</a>{% else %}{{ content.title | escape }}{% endif %}
        </h3>
      {% endif %}
      {% if content.institution %}<p class="cv-institution">{{ content.institution | escape }}</p>{% endif %}
      {% if content.department %}<p class="cv-institution">{{ content.department | escape }}</p>{% endif %}
      {% if education_credential %}
        <p class="credential-meta">Issued <time datetime="{{ education_credential.issued }}">{{ education_credential.issuedLabel }}</time><br>Expires <time datetime="{{ education_credential.expires }}">{{ education_credential.expiresLabel }}</time></p>
      {% endif %}
      {% if content.maindescription %}<div class="cv-description">{{ content.maindescription | markdownify }}</div>{% endif %}
      {% if content.description and content.description.size > 0 %}
        <ul class="cv-description">
          {% for item in content.description %}
            <li>
              {% if item.contents %}
                {{ item.title | markdownify }}
                <ul>{% for subitem in item.contents %}<li>{{ subitem | markdownify }}</li>{% endfor %}</ul>
              {% else %}
                {{ item | markdownify }}
              {% endif %}
            </li>
          {% endfor %}
        </ul>
      {% endif %}
      {% if content.items and content.items.size > 0 %}
        <ul class="cv-description">
          {% for item in content.items %}
            <li>
              {% if item.contents %}
                {{ item.title | markdownify }}
                <ul>{% for subitem in item.contents %}<li>{{ subitem | markdownify }}</li>{% endfor %}</ul>
              {% else %}
                {{ item | markdownify }}
              {% endif %}
            </li>
          {% endfor %}
        </ul>
      {% endif %}
      {% if content.linkitems %}
        <div class="cv-links">
          {% for item in content.linkitems %}
            {% if item.link %}<a href="{{ item.link }}" target="_blank" rel="noopener noreferrer">{{ item.linkname | default: 'View document' | escape }}</a>{% endif %}
          {% endfor %}
        </div>
      {% endif %}
    </div>
  </div>
{% endfor %}
